# DropItX API — Local Dev Environment
# Copy to .env and fill in values

# --- Supabase (Auth JWT verification only — cloud) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local PostgreSQL ---
DATABASE_URL=postgresql://dropitx:dropitx_local_dev@localhost:5432/dropitx

# --- Local MinIO/S3 ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dropitx
S3_SECRET_KEY=dropitx_local_dev

# --- App ---
ALLOWED_ORIGINS=http://localhost:3000,https://dropitx.vercel.app
FRONTEND_URL=http://localhost:3000
